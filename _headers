# Read by Cloudflare Pages and Netlify (GitHub Pages ignores this file).

# The page itself: always ask the server, so an update is seen at once.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Built scripts, styles and fonts have a fingerprint in their name: a changed
# file gets a new name, so these can be kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The model and its textures keep the same names when re-exported, so keep
# them for an hour and then check.
/models/*
  Cache-Control: public, max-age=3600
# Cloudflare only compresses the file types on its own list, and 3D models
# (model/gltf-binary) are not on it: the compact model would be sent at twice
# the size. Labelling that one file as generic binary data, a type that is on
# the list, makes Cloudflare compress it. Browsers read it the same way. The
# plain model keeps its proper type, because Android Scene Viewer fetches it.
/models/*.web.glb
  ! Content-Type
  Content-Type: application/x-protobuf
/models/*.usdz
  Content-Type: model/vnd.usdz+zip
